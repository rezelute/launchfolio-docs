{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "const": "summary"
          },
          {
            "type": "string",
            "const": "education"
          },
          {
            "type": "object",
            "properties": {
              "projects": {
                "type": "object",
                "properties": {
                  "include": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "include"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "projects"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "experience": {
                "type": "object",
                "properties": {
                  "include": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "include"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "experience"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "title",
    "tagline",
    "summary",
    "sections"
  ],
  "additionalProperties": false
}