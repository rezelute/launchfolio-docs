{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "institution": {
        "type": "string"
      },
      "area": {
        "type": "string"
      },
      "studyType": {
        "type": "string"
      },
      "grade": {
        "type": "string"
      },
      "startDate": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      },
      "endDate": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "required": [
      "id",
      "institution",
      "area",
      "studyType",
      "grade",
      "startDate",
      "endDate"
    ],
    "additionalProperties": false
  }
}