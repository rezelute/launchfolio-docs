{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "type": {
        "type": "string",
        "enum": [
          "employment",
          "sabbatical"
        ]
      },
      "icon": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "position": {
        "type": [
          "string",
          "null"
        ]
      },
      "location": {
        "type": [
          "string",
          "null"
        ]
      },
      "remote": {
        "type": [
          "string",
          "null"
        ]
      },
      "companySize": {
        "type": [
          "string",
          "null"
        ]
      },
      "companyType": {
        "type": [
          "string",
          "null"
        ]
      },
      "reasonForLeaving": {
        "type": [
          "string",
          "null"
        ]
      },
      "startDate": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}$"
      },
      "endDate": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "url": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "null"
          }
        ]
      },
      "summary": {
        "type": "string"
      },
      "promotions": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "technologies": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "highlights": {
        "default": [],
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "management",
                  "technical",
                  "personal"
                ]
              }
            }
          },
          "required": [
            "id",
            "text"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "type",
      "icon",
      "name",
      "startDate",
      "summary",
      "technologies",
      "highlights"
    ],
    "additionalProperties": false
  }
}