{
  "$ref": "#/definitions/experience",
  "definitions": {
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "employment",
              "sabbatical"
            ]
          },
          "icon": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "remote": {
            "type": [
              "string",
              "null"
            ]
          },
          "companySize": {
            "type": [
              "string",
              "null"
            ]
          },
          "companyType": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasonForLeaving": {
            "type": [
              "string",
              "null"
            ]
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "errorMessage": {
              "pattern": "Must be YYYY-MM"
            }
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$",
                "errorMessage": {
                  "pattern": "Must be YYYY-MM"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string"
          },
          "promotions": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "highlights": {
            "type": "object",
            "properties": {
              "management": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "technical": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "personal": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false,
            "default": {}
          }
        },
        "required": [
          "id",
          "type",
          "icon",
          "name",
          "startDate",
          "summary",
          "technologies"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}