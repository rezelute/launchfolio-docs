{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "type": {
        "type": "string",
        "enum": [
          "personal",
          "client"
        ]
      },
      "icon": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "startDate": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}$"
      },
      "endDate": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": {
        "type": "string"
      },
      "highlights": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "management",
                  "technical",
                  "personal"
                ]
              }
            }
          },
          "required": [
            "id",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "technologies": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "url": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "null"
          }
        ]
      },
      "repo": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "null"
          }
        ]
      },
      "cover": {
        "type": "string"
      },
      "screenshots": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "relatedBlogs": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "client": {
        "type": "string"
      },
      "client_public": {
        "type": "boolean"
      },
      "press": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "outlet": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "outlet",
            "url"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "type",
      "icon",
      "name",
      "startDate",
      "description",
      "highlights",
      "technologies",
      "screenshots",
      "relatedBlogs"
    ],
    "additionalProperties": false
  }
}