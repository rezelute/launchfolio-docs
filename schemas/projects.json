{
  "$ref": "#/definitions/projects",
  "definitions": {
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "personal",
              "client"
            ]
          },
          "icon": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "errorMessage": {
              "pattern": "Must be YYYY-MM"
            }
          },
          "endDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$",
                "errorMessage": {
                  "pattern": "Must be YYYY-MM"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "repo": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "cover": {
            "type": "string"
          },
          "screenshots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "relatedBlogs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "client": {
            "type": "string"
          },
          "client_public": {
            "type": "boolean"
          },
          "press": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "outlet": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "outlet",
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "type",
          "icon",
          "name",
          "startDate",
          "description",
          "highlights",
          "technologies"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}