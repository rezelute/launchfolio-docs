# Path to your persona-data directory.
# Docker: path inside the container - must match the target of your volume mount in docker-compose.yml
# Local dev: absolute path to your persona-data folder on disk
PERSONA_DATA_PATH=/app/content

# Primary theme color - any PrimeVue/Tailwind color name:
# violet | purple | indigo | blue | sky | teal | emerald | green | orange | rose
# NOTE: Baked into CSS at build time. Changing this requires a full rebuild - does NOT hot-reload.
NUXT_PUBLIC_PRIMARY_COLOR=violet

# Secondary theme color - optional, used for hero gradient blend
# Same palette options as PRIMARY_COLOR. Leave unset for single-color hero.
# NOTE: Same as PRIMARY_COLOR - requires a rebuild to take effect.
NUXT_PUBLIC_SECONDARY_COLOR=blue

# Hero section background pattern (runtime - no rebuild needed)
# Options: grid-orbs | aurora | topographic | rays | noise | geometric | synthwave
NUXT_PUBLIC_HERO_PATTERN=geometric

# Show "Built with Launchfolio" attribution in the footer
NUXT_PUBLIC_SHOW_ATTRIBUTION=true

# Analytics - Umami (all optional, leave unset to disable)
# NUXT_PUBLIC_UMAMI_SCRIPT=https://cloud.umami.is/script.js
# NUXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id

# Site URL - used by @nuxtjs/sitemap to generate absolute URLs in sitemap.xml
# and by social sharing meta tags. Set to your production domain.
NUXT_PUBLIC_SITE_URL=https://yourdomain.com
